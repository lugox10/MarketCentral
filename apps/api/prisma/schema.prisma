// MarketCentral — Esquema Prisma
// E1: identidad y sesiones · E2: negocios y membresías · E3: taxonomía global
// Fuente: docs/15 (modelo E-R), docs/16 (diccionario), docs/19 (índices e integridad).
// En Prisma 7 la URL de conexión vive en prisma.config.ts; aquí solo el modelo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Municipios del Área Metropolitana del Valle de Aburrá (Q-16, docs/16 §2.1).
enum AmvaCity {
  MEDELLIN
  BELLO
  ITAGUI
  ENVIGADO
  SABANETA
  LA_ESTRELLA
  CALDAS
  COPACABANA
  GIRARDOTA
  BARBOSA
}

/// Sin `PENDING_REVIEW`: el negocio nace aprobado (Q-07, docs/04 R-16).
enum BusinessStatus {
  APPROVED
  SUSPENDED
}

/// Roles internos del negocio (MVP: solo `OWNER` se asigna).
enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

/// Catálogo de planes del MVP (Q-02/Q-03).
enum PlanCode {
  FREE
  BASE
  PRO
}

/// Cinco estados de docs/18 §4 (ADR-010).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

/// Identidad del usuario. El correo se guarda en minúsculas y es único (citext).
model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  name            String     @db.VarChar(120)
  role            UserRole   @default(BUSINESS_OWNER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  memberships             BusinessMembership[]

  @@map("app_user")
}

/// Sesión servidor: solo se persiste el hash SHA-256 del token opaco.
model Session {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipHash    String?   @map("ip_hash") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(400)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Token de restablecimiento de contraseña (solo hash).
model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

/// Token de verificación de correo (solo hash).
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_token")
}

/// Negocio (tenant). Nace `APPROVED`: no hay moderación previa (Q-07).
model Business {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String         @db.VarChar(80)
  slug        String         @unique @db.VarChar(60)
  city        AmvaCity
  addressLine String?        @map("address_line") @db.VarChar(160)
  whatsapp    String         @map("whatsapp_e164") @db.VarChar(20)
  status      BusinessStatus @default(APPROVED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  BusinessMembership[]
  subscription Subscription?

  @@index([status])
  @@map("business")
}

/// Membresía usuario–negocio. Único `(business_id, user_id)`.
model BusinessMembership {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_membership")
}

/// Plan contratable. Free = 60 días de prueba y 0 COP (Q-02/Q-03).
model Plan {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code           PlanCode @unique
  name           String   @unique @db.VarChar(40)
  priceCop       Int      @map("price_cop")
  intervalMonths Int      @map("interval_months") @db.SmallInt
  trialDays      Int      @map("trial_days") @db.SmallInt
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plan")
}

/// Suscripción del negocio. Una por negocio en el MVP (`business_id` único).
model Subscription {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId         String             @unique @map("business_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("subscription")
}

// ---------------------------------------------------------------------------
// E3 · Taxonomía global (docs/22 E3, docs/15 §4)
// No pertenece a ningún negocio: la administra la plataforma.
// ---------------------------------------------------------------------------

/// Tipos de atributo admitidos. Solo `ENUM` acepta opciones.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

/// Sector comercial (p. ej. «Prenderías»). Global y reutilizable.
model Vertical {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories Category[]

  @@index([isActive])
  @@map("vertical")
}

/// Categoría de una vertical. Puede colgar de otra categoría de la misma vertical.
model Category {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  verticalId String   @map("vertical_id") @db.Uuid
  name       String   @db.VarChar(60)
  slug       String   @db.VarChar(60)
  parentId   String?  @map("parent_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vertical   Vertical              @relation(fields: [verticalId], references: [id], onDelete: Restrict)
  parent     Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]            @relation("CategoryHierarchy")
  attributes AttributeDefinition[]

  @@unique([verticalId, slug])
  @@index([verticalId])
  @@index([parentId])
  @@map("category")
}

/// Atributo configurable de una categoría (`attributes` JSONB en las publicaciones, ADR-009).
model AttributeDefinition {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  name         String        @db.VarChar(60)
  code         String        @db.VarChar(40)
  type         AttributeType
  isRequired   Boolean       @default(false) @map("is_required")
  isFilterable Boolean       @default(true) @map("is_filterable")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  AttributeOption[]

  @@unique([categoryId, code])
  @@index([categoryId])
  @@map("attribute_definition")
}

/// Opción de un atributo `ENUM`. La regla «solo ENUM admite opciones» se valida
/// en dominio y aplicación (docs/22 E3-H3).
model AttributeOption {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attributeDefinitionId String   @map("attribute_definition_id") @db.Uuid
  value                 String   @db.VarChar(60)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([attributeDefinitionId, value])
  @@index([attributeDefinitionId])
  @@map("attribute_option")
}
