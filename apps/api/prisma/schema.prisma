// MarketCentral — Esquema Prisma
// E1: identidad y sesiones · E2: negocios y membresías · E3: taxonomía global
// Fuente: docs/15 (modelo E-R), docs/16 (diccionario), docs/19 (índices e integridad).
// En Prisma 7 la URL de conexión vive en prisma.config.ts; aquí solo el modelo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Municipios del Área Metropolitana del Valle de Aburrá (Q-16, docs/16 §2.1).
enum AmvaCity {
  MEDELLIN
  BELLO
  ITAGUI
  ENVIGADO
  SABANETA
  LA_ESTRELLA
  CALDAS
  COPACABANA
  GIRARDOTA
  BARBOSA
}

/// Sin `PENDING_REVIEW`: el negocio nace aprobado (Q-07, docs/04 R-16).
enum BusinessStatus {
  APPROVED
  SUSPENDED
}

/// Roles internos del negocio (MVP: solo `OWNER` se asigna).
enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

/// Catálogo de planes del MVP (Q-02/Q-03).
enum PlanCode {
  FREE
  BASE
  PRO
}

/// Cinco estados de docs/18 §4 (ADR-010). En E4 solo se asignan `TRIALING`,
/// `ACTIVE` y `EXPIRED`; `SUSPENDED` y `CANCELLED` se conservan para no romper
/// el modelo y no se usan (D-38).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

/// Tipo de operación registrada en el historial de activaciones (E4).
enum SubscriptionActivationKind {
  ACTIVATED
  RENEWED
  PLAN_CHANGED
  TRIAL_ADJUSTED
}

/// Identidad del usuario. El correo se guarda en minúsculas y es único (citext).
model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  name            String     @db.VarChar(120)
  role            UserRole   @default(BUSINESS_OWNER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  memberships             BusinessMembership[]
  ownedBusinesses         Business[]               @relation("BusinessOwner")
  activatedSubscriptions  Subscription[]           @relation("SubscriptionActivatedBy")
  performedActivations    SubscriptionActivation[] @relation("ActivationPerformedBy")
  submittedReports        Report[]                 @relation("ReportReporter")
  resolvedReports         Report[]                 @relation("ReportResolver")
  moderationActions       ModerationAction[]

  @@map("app_user")
}

/// Sesión servidor: solo se persiste el hash SHA-256 del token opaco.
model Session {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipHash    String?   @map("ip_hash") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(400)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Token de restablecimiento de contraseña (solo hash).
model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

/// Token de verificación de correo (solo hash).
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_token")
}

/// Negocio (tenant). Pertenece a una sola vertical y a un único dueño (D-40).
/// El WhatsApp y la huella nombre+dirección son únicos dentro de la vertical
/// para frenar negocios duplicados (D-41).
model Business {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String         @db.VarChar(80)
  slug             String         @unique @db.VarChar(60)
  city             AmvaCity
  addressLine      String         @map("address_line") @db.VarChar(160)
  whatsapp         String         @map("whatsapp_e164") @db.VarChar(20)
  description      String?        @db.VarChar(600)
  logoKey          String?        @map("logo_key") @db.VarChar(300)
  coverKey         String?        @map("cover_key") @db.VarChar(300)
  fingerprint      String         @db.VarChar(200)
  verticalId       String         @map("vertical_id") @db.Uuid
  ownerUserId      String         @map("owner_user_id") @db.Uuid
  flaggedForReview Boolean        @default(false) @map("flagged_for_review")
  status           BusinessStatus @default(APPROVED)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  vertical     Vertical             @relation(fields: [verticalId], references: [id], onDelete: Restrict)
  owner        User                 @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships  BusinessMembership[]
  subscription Subscription?
  categories   Category[]
  listings     Listing[]
  leads        Lead[]
  reports      Report[]
  moderationActions ModerationAction[]

  @@unique([verticalId, ownerUserId])
  @@unique([verticalId, whatsapp])
  @@unique([verticalId, fingerprint])
  @@index([status])
  @@index([ownerUserId])
  @@map("business")
}

/// Membresía usuario–negocio. Único `(business_id, user_id)`.
model BusinessMembership {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_membership")
}

/// Plan contratable (E4). `trialMonths` solo aplica a Free (dos meses
/// calendario); `billingPeriodDays` es la duración de una activación pagada.
model Plan {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code              PlanCode @unique
  name              String   @unique @db.VarChar(40)
  priceCop          Int      @map("price_cop")
  currency          String   @default("COP") @db.Char(3)
  maxListings       Int      @map("max_listings") @db.SmallInt
  maxCategories     Int      @default(0) @map("max_categories") @db.SmallInt
  featuredSlots     Int      @default(0) @map("featured_slots") @db.SmallInt
  trialMonths       Int      @default(0) @map("trial_months") @db.SmallInt
  trialDays         Int?     @map("trial_days") @db.SmallInt
  billingPeriodDays Int?     @map("billing_period_days") @db.SmallInt
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  activations   SubscriptionActivation[]

  @@map("plan")
}

/// Suscripción del negocio. Una por negocio en el MVP (`business_id` único).
/// Renovaciones y cambios de plan se registran en `subscription_activation`.
model Subscription {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId         String             @unique @map("business_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  activatedByAdminId String?            @map("activated_by_admin_id") @db.Uuid
  activationNote     String?            @map("activation_note") @db.VarChar(500)
  expiryNotifiedOn   DateTime?          @map("expiry_notified_on") @db.Date
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  activatedBy User?                    @relation("SubscriptionActivatedBy", fields: [activatedByAdminId], references: [id], onDelete: SetNull)
  activations SubscriptionActivation[]

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscription")
}

/// Historial inmutable de activaciones manuales (E4).
/// No tiene endpoints de escritura: solo lo crea la activación confirmada.
/// Un trigger de la migración bloquea los UPDATE.
model SubscriptionActivation {
  id                 String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriptionId     String                     @map("subscription_id") @db.Uuid
  planId             String                     @map("plan_id") @db.Uuid
  activatedByAdminId String?                    @map("activated_by_admin_id") @db.Uuid
  kind               SubscriptionActivationKind
  note               String                     @db.VarChar(500)
  activatedAt        DateTime                   @default(now()) @map("activated_at") @db.Timestamptz(6)
  periodStart        DateTime                   @map("period_start") @db.Timestamptz(6)
  previousPeriodEnd  DateTime?                  @map("previous_period_end") @db.Timestamptz(6)
  newPeriodEnd       DateTime                   @map("new_period_end") @db.Timestamptz(6)
  priceCop           Int                        @map("price_cop")
  currency           String                     @default("COP") @db.Char(3)
  idempotencyKey     String?                    @unique @map("idempotency_key") @db.VarChar(80)
  requestHash        String?                    @map("request_hash") @db.VarChar(64)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  activatedBy  User?        @relation("ActivationPerformedBy", fields: [activatedByAdminId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, activatedAt])
  @@index([planId])
  @@map("subscription_activation")
}

// ---------------------------------------------------------------------------
// E3 · Taxonomía global (docs/22 E3, docs/15 §4)
// No pertenece a ningún negocio: la administra la plataforma.
// ---------------------------------------------------------------------------

/// Tipos de atributo admitidos. Solo `ENUM` acepta opciones.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

/// Sector comercial (p. ej. «Prenderías»). Global y reutilizable.
model Vertical {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories Category[]
  businesses Business[]

  @@index([isActive])
  @@map("vertical")
}

/// Categoría de una vertical. Puede colgar de otra categoría de la misma vertical.
model Category {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  verticalId String   @map("vertical_id") @db.Uuid
  name       String   @db.VarChar(60)
  slug       String   @db.VarChar(60)
  parentId   String?  @map("parent_id") @db.Uuid
  businessId String?  @map("business_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vertical   Vertical              @relation(fields: [verticalId], references: [id], onDelete: Restrict)
  business   Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]            @relation("CategoryHierarchy")
  attributes AttributeDefinition[]
  listings   Listing[]

  @@index([verticalId])
  @@index([businessId])
  @@index([parentId])
  @@map("category")
}

/// Atributo configurable de una categoría (`attributes` JSONB en las publicaciones, ADR-009).
model AttributeDefinition {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  name         String        @db.VarChar(60)
  code         String        @db.VarChar(40)
  type         AttributeType
  isRequired   Boolean       @default(false) @map("is_required")
  isFilterable Boolean       @default(true) @map("is_filterable")
  /// Borrado lógico: un atributo inactivo no se pide en publicaciones nuevas,
  /// pero las publicaciones antiguas conservan su valor en `listing.attributes`.
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  AttributeOption[]

  @@unique([categoryId, code])
  @@index([categoryId])
  @@index([categoryId, isActive])
  @@map("attribute_definition")
}

/// Opción de un atributo `ENUM`. La regla «solo ENUM admite opciones» se valida
/// en dominio y aplicación (docs/22 E3-H3).
model AttributeOption {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attributeDefinitionId String   @map("attribute_definition_id") @db.Uuid
  value                 String   @db.VarChar(60)
  /// Borrado lógico: una opción inactiva no se ofrece al crear una publicación,
  /// pero las publicaciones antiguas que la usaron no cambian.
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([attributeDefinitionId, value])
  @@index([attributeDefinitionId])
  @@map("attribute_option")
}

/// Estado de una publicación (ADR-011). `ARCHIVED` es terminal e irreversible:
/// retirar una publicación equivale a eliminarla y no se republica.
enum ListingStatus {
  DRAFT
  PUBLISHED
  SOLD
  ARCHIVED
}

/// Condición declarada del artículo. Obligatoria en la vertical de prenderías.
enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

/// Publicación de un negocio en una categoría de su vertical (E5).
///
/// Los atributos variables por vertical viven en `attributes` (JSONB) con la
/// versión de esquema que los validó (ADR-009); nunca en columnas por sector.
model Listing {
  id                      String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId              String           @map("business_id") @db.Uuid
  categoryId              String           @map("category_id") @db.Uuid
  title                   String           @db.VarChar(120)
  description             String           @db.VarChar(4000)
  condition               ListingCondition
  priceAmount             Int              @map("price_amount")
  currency                String           @default("COP") @db.Char(3)
  status                  ListingStatus    @default(DRAFT)
  slug                    String           @db.VarChar(90)
  attributes              Json             @default("{}")
  attributesSchemaVersion Int              @default(1) @map("attributes_schema_version") @db.SmallInt
  featured                Boolean          @default(false)
  featuredAt              DateTime?        @map("featured_at") @db.Timestamptz(6)
  publishedAt             DateTime?        @map("published_at") @db.Timestamptz(6)
  soldAt                  DateTime?        @map("sold_at") @db.Timestamptz(6)
  archivedAt              DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ListingImage[]
  leads    Lead[]
  reports  Report[]
  moderationActions ModerationAction[]

  @@unique([businessId, slug])
  @@index([businessId, status])
  @@index([categoryId, status])
  @@index([status, featured])
  @@map("listing")
}

/// Imagen de una publicación almacenada en un proveedor externo compatible S3.
/// La base solo guarda la clave y metadatos; nunca los bytes.
model ListingImage {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(300)
  mimeType   String   @map("mime_type") @db.VarChar(40)
  sizeBytes  Int      @map("size_bytes")
  width      Int?
  height     Int?
  position   Int      @default(0) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
  @@map("listing_image")
}

/// Estado de gestión del lead por parte del negocio.
enum LeadStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

/// Punto de entrada del contacto: una publicación o el perfil del negocio.
enum LeadSource {
  LISTING
  BUSINESS_PROFILE
}

/// Contacto enviado por un comprador. No hay chat: la conversación sigue fuera.
model Lead {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  listingId  String?    @map("listing_id") @db.Uuid
  buyerName  String     @map("buyer_name") @db.VarChar(100)
  buyerEmail String     @map("buyer_email") @db.VarChar(320)
  buyerPhone String     @map("buyer_phone") @db.VarChar(20)
  message    String     @db.VarChar(2000)
  status     LeadStatus @default(NEW)
  source     LeadSource @default(LISTING)
  consentAt  DateTime   @map("consent_at") @db.Timestamptz(6)
  ipHash     String     @map("ip_hash") @db.Char(64)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([listingId, createdAt])
  @@index([listingId, buyerEmail, createdAt])
  @@index([expiresAt])
  @@map("lead")
}

/// Motivo de una denuncia ciudadana sobre una publicación o un negocio.
enum ReportReason {
  SCAM
  STOLEN
  INAPPROPRIATE
  WRONG_CATEGORY
  OTHER
}

/// Estado de gestión de la denuncia por parte de la plataforma.
enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

/// Acción de moderación ejecutada por un administrador. Es el rastro de
/// auditoría de E8: quién suspendió, archivó o resolvió, cuándo y por qué.
enum ModerationActionKind {
  REPORT_STATUS_CHANGED
  BUSINESS_SUSPENDED
  BUSINESS_REACTIVATED
  LISTING_ARCHIVED
}

/// Denuncia enviada desde el marketplace público. El denunciante puede ser
/// anónimo (solo se guarda el hash de su IP) o un usuario con sesión.
model Report {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reporterUserId    String?      @map("reporter_user_id") @db.Uuid
  reporterEmail     String?      @map("reporter_email") @db.VarChar(320)
  reporterIpHash    String       @map("reporter_ip_hash") @db.Char(64)
  businessId        String       @map("business_id") @db.Uuid
  listingId         String?      @map("listing_id") @db.Uuid
  reason            ReportReason
  details           String?      @db.VarChar(2000)
  status            ReportStatus @default(PENDING)
  resolvedByAdminId String?      @map("resolved_by_admin_id") @db.Uuid
  resolutionNote    String?      @map("resolution_note") @db.VarChar(500)
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter User?             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  resolver User?             @relation("ReportResolver", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  listing  Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  actions  ModerationAction[]

  @@index([status, createdAt])
  @@index([businessId, createdAt])
  @@index([listingId, createdAt])
  @@map("report")
}

/// Registro inmutable de una acción de moderación.
model ModerationAction {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String               @map("actor_user_id") @db.Uuid
  reportId    String?              @map("report_id") @db.Uuid
  businessId  String?              @map("business_id") @db.Uuid
  listingId   String?              @map("listing_id") @db.Uuid
  kind        ModerationActionKind
  reason      String               @db.VarChar(500)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  actor    User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  report   Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([listingId, createdAt])
  @@index([reportId])
  @@map("moderation_action")
}