# MarketCentral — variables de entorno de ejemplo
# Copia este archivo a `.env` (raíz del monorepo) y ajusta los valores.
# Nunca confirmes `.env` con credenciales reales.

# --- Base de datos ---------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketcentral_dev

# --- API (NestJS, apps/api) ------------------------------------------------
API_PORT=3001
NODE_ENV=development
# Lista separada por comas. Sin comodines en producción.
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js, apps/web) ----------------------------------------------
# URL pública de la API. En producción debe ser https.
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL pública del sitio: canonical, Open Graph, enlaces de correo y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de datos en Docker Compose --------------------------------------
# Cambiar en equipos compartidos; no son credenciales de producción.
POSTGRES_DB=marketcentral_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Correo saliente (E9) --------------------------------------------------
# Sin RESEND_API_KEY la API usa ConsoleMailSender: imprime el correo en el log
# en vez de enviarlo. Es el modo correcto para desarrollo y pruebas.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado en el proveedor. El dominio debe estar autenticado
# (SPF/DKIM) antes de usarlo en producción.
# MAIL_FROM="MarketCentral <no-responder@marketcentral.app>"
# Responder a (opcional).
# MAIL_REPLY_TO=soporte@marketcentral.app

# --- Imágenes de publicaciones (E5) ---------------------------------------
# Sin MEDIA_S3_BUCKET la API guarda en disco local y sirve /media desde ella.
# MEDIA_LOCAL_DIR=.var/media
# MEDIA_PUBLIC_BASE_URL=http://localhost:3001/media
#
# Con las cinco variables siguientes se usa almacenamiento compatible con S3
# (Cloudflare R2, MinIO, AWS S3...). La decisión de proveedor sigue PENDIENTE:
# ver docs/decisions/ADR-006-production-database-provider.md y docs/23.
# MEDIA_S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=marketcentral-media
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# URL pública del bucket (dominio propio o r2.dev). Si falta, se usa
# `${MEDIA_S3_ENDPOINT}/${MEDIA_S3_BUCKET}`.
# MEDIA_S3_PUBLIC_BASE_URL=https://media.example.com

# --- Retención de imágenes ------------------------------------------------
# Las fotos de publicaciones ARCHIVED se purgan pasados estos días (mínimo 7).
# Las de borradores, publicadas y vendidas se conservan siempre.
# MEDIA_PURGE_ARCHIVED_DAYS=90
# MEDIA_PURGE_ENABLED=true

# --- Límites públicos y secretos de formularios (E6/E7/E8) ----------------
# Peticiones por minuto y por IP en el catálogo público.
# PUBLIC_RATE_LIMIT=180
# Secretos HMAC para el token del formulario, la huella de IP y las
# denuncias. En producción son obligatorios y deben ser aleatorios (32+ bytes).
# FORM_TOKEN_SECRET=
# IP_HASH_SECRET=

# --- Copias de seguridad (E9) ---------------------------------------------
# Carpeta local de los dumps (relativa a la raíz del repo).
# BACKUP_DIR=.var/backups
# Días de retención; los dumps más antiguos se borran tras un backup correcto.
# BACKUP_KEEP_DAYS=14
