# Store y caché dentro del workspace para que la instalación sea reproducible y
# no escriba fuera del repositorio (sandbox / CI).
store-dir=.cache/pnpm-store
cache-dir=.cache/pnpm-cache
state-dir=.cache/pnpm-state

# Layout hoisted + paquetes del workspace inyectados (copias reales, sin
# symlinks ni junctions): Next.js 16 con Turbopack no resuelve paquetes a través
# de junctions en Windows cuando no hay privilegio de symlink. Ver docs/21.
node-linker=hoisted
inject-workspace-packages=true

# Sin "global virtual store": deja enlaces a paquetes fuera del repo.
enable-global-virtual-store=false

# El lockfile siempre se commitea; fallar si falta en CI.
prefer-frozen-lockfile=true

# Estricto con peers: un peer incompatible debe verse en la instalación, no en runtime.
strict-peer-dependencies=true
